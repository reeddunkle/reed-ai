{
  "version": 1,
  "environments": [
    {
      "id": "windows",
      "targets": ["claude", "codex"]
    },
    {
      "id": "wsl",
      "homeVariable": "REED_AI_WSL_HOME",
      "targets": ["claude"]
    }
  ],
  "conversationRetention": {
    "codex": {
      "enabled": true,
      "archiveAfterDays": 14
    },
    "claude": {
      "enabled": false,
      "archiveAfterDays": 14
    }
  },
  "marketplace": {
    "name": "reed-ai",
    "source": ".agents/plugins/marketplace.json"
  },
  "skills": [
    {
      "id": "archive-claude-sessions",
      "targets": ["claude"]
    },
    {
      "id": "caveman",
      "targets": ["claude", "codex"]
    },
    {
      "id": "code-comment-policy",
      "targets": ["claude", "codex"]
    },
    {
      "id": "data-transformation-style",
      "targets": ["claude", "codex"]
    },
    {
      "id": "effect-conventions",
      "targets": ["claude", "codex"]
    },
    {
      "id": "effect-layer-conventions",
      "targets": ["claude", "codex"]
    },
    {
      "id": "general-js-ts-style",
      "targets": ["claude", "codex"]
    },
    {
      "id": "node-with-fnm",
      "targets": ["claude", "codex"]
    }
  ],
  "plugins": [
    {
      "id": "pstack",
      "packageName": "pstack-skills",
      "source": "plugins/pstack",
      "explicitOnly": true,
      "claudeDestination": ".claude/skills/pstack-claude-plugin"
    }
  ],
  "instructions": [
    {
      "source": "instructions/shared.md",
      "destinations": [
        ".claude/AGENTS.md",
        ".claude/CLAUDE.md",
        ".codex/AGENTS.md"
      ]
    }
  ],
  "settings": [
    {
      "source": "config/desired-settings.json",
      "destination": ".claude/settings.json",
      "target": "claude",
      "selector": "claude.settings",
      "format": "json"
    },
    {
      "source": "config/desired-settings.json",
      "destination": ".codex/config.toml",
      "target": "codex",
      "selector": "codex.config",
      "format": "toml-booleans"
    }
  ],
  "thirdParty": [
    {
      "id": "find-skills",
      "source": "vercel-labs/skills",
      "managedBy": "skills installer"
    },
    {
      "id": "mattpocock-skills",
      "version": "1.2.3",
      "managedBy": "Claude and Codex plugin managers"
    }
  ]
}
